# ─────────────────────────────────────────────────────────────
# Candy_Ksendy — шаблон переменных окружения
#
# ⚠️ ЭТОТ ФАЙЛ ПОПАДАЁТ В РЕПОЗИТОРИЙ. Реальные значения сюда не вписывать.
#
# Локально: скопируй файл в .env и подставь значения там.
#           Файл .env в репозиторий не коммитится (см. .gitignore).
# На проде:  Vercel → Settings → Environment Variables.
# ─────────────────────────────────────────────────────────────

# ─── КЛИЕНТ ─────────────────────────────────────────────────
# Префикс VITE_ обязателен: только такие переменные попадают в браузер.
# Эти ключи не секретные — доступ ограничивается правилами firestore.rules.

VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# ─── СЕРВЕР ─────────────────────────────────────────────────
# Всё, что ниже, видит только функция /api/order на Vercel.
# НИКОГДА не добавляй к этим именам префикс VITE_: переменная утечёт в браузер.

# Firebase Admin SDK — сервисный аккаунт проекта Firebase.
# Консоль Firebase → Настройки проекта → Сервисные аккаунты → Создать закрытый ключ.
# Приватный ключ вставляется одной строкой, переводы строк экранированы как \n.
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# Telegram. Токен выдаёт @BotFather, chat_id — @userinfobot в личке Ксении.
TELEGRAM_BOT_TOKEN=
TELEGRAM_ADMIN_CHAT_ID=

# Google Sheets. Настройка сервисного аккаунта — см. google-sheets-setup.md.
# Не забудь выдать сервисному аккаунту доступ «Редактор» к самой таблице.
GOOGLE_SPREADSHEET_ID=
GOOGLE_SERVICE_ACCOUNT_EMAIL=
GOOGLE_PRIVATE_KEY=
# Имя листа. По умолчанию «Лист1» — менять только если лист переименован.
GOOGLE_SHEET_NAME=Лист1

# Соль для хэширования IP в счётчиках антиспама.
# Любая случайная строка; без неё адрес восстанавливается перебором.
RATE_LIMIT_SALT=
