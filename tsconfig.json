{
  // Корневой файл-решение: сам ничего не компилирует, а связывает
  // подпроекты. Без него vite.config.ts и папка scripts не попадали ни
  // в один проект — редактор помечал их ошибкой, а типы в них не
  // проверялись вовсе.
  //
  // Серверные функции живут в отдельном проекте api/tsconfig.json: у них
  // другая среда (Node вместо браузера) и своё разрешение модулей — NodeNext
  // против bundler, — поэтому в references они не входят.
  //
  // ВАЖНО: из-за этого `tsc -b` их НЕ проверяет. Раньше команда build
  // состояла только из `tsc -b && vite build`, и сборка проходила успешно
  // даже при ошибке типов в api/order.ts. Vercel собирает функции через
  // esbuild, без проверки типов, так что сломанный обработчик заказов
  // уезжал бы на прод молча. Теперь build вызывает npm run typecheck,
  // который проверяет оба проекта. Не убирайте этот вызов.
  "files": [],
  "references": [{ "path": "./tsconfig.app.json" }, { "path": "./tsconfig.node.json" }]
}
